    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1",
    "socket.io-msgpack-parser": "^3.0.2",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
